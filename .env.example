# Copy this file to .env and adjust. Never commit .env.
# On Hostinger, enter these as Environment variables instead (see DEPLOY-HOSTINGER.md).

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Empty = 127.0.0.1 in development, 0.0.0.0 in production.
HOST=
# Dates, shifts, late/early and "today" use this time zone, even if the server runs in UTC.
APP_TIMEZONE=Asia/Kolkata

# ── Database (XAMPP MySQL / MariaDB, or Hostinger MySQL) ──────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=infinity_ops
# XAMPP default is root with no password. For production create a dedicated
# user with database/create-app-user.sql and put it here.
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Create tables / run migrations / create first accounts when the server starts.
# Empty = on in production, off in development (use npm run db:setup locally).
DB_AUTO_SETUP=
# Starter data on an empty database: staff (admin + staff + roster), demo (+ sample activity), none
DB_SEED=staff
# Initial passwords for the first accounts. Everyone must change it at first sign-in.
# Must have 10+ chars with upper, lower, number and symbol.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# ── Security ───────────────────────────────────────────────────
# Extra browser origins allowed to call the API (the site's own address is always allowed).
CORS_ORIGINS=http://localhost:5288
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Empty = true in production (HTTPS), false in development.
COOKIE_SECURE=
# Behind a reverse proxy (Hostinger, IIS, Nginx). Empty = true in production.
TRUST_PROXY=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Biometric machines (eSSL / ZKTeco, TCP 4370 like HRMS) ─────
# direct = this server reads the machines on the office LAN (app installed in the office)
# agent  = app is online (Hostinger); an office PC runs the agent and sends punches here
BIOMETRIC_MODE=direct
# Agent mode only: shared secret, 32+ characters. Generate: npm run agent:key
BIOMETRIC_AGENT_KEY=
# Direct mode: pull every N minutes (0 = only when Sync is clicked). Agent mode: agent sync interval.
BIOMETRIC_AUTO_SYNC_MINUTES=15
# IPs or CIDR ranges machines may be added with (comma separated). Empty = private LAN only.
BIOMETRIC_ALLOWED_IPS=
