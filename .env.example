# Copy this file to .env and adjust. Never commit .env.

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to allow other PCs on the LAN.
HOST=127.0.0.1

# ── Database (XAMPP MySQL / MariaDB) ───────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=infinity_ops
# XAMPP default is root with no password. For production create a dedicated
# user with database/create-app-user.sql and put it here.
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# ── Security ───────────────────────────────────────────────────
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5288,http://localhost:4000
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Requires HTTPS. Leave empty to use true in production, false in development.
COOKIE_SECURE=
# true when behind IIS / Nginx / Apache reverse proxy.
TRUST_PROXY=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── First-time setup (npm run db:setup) ────────────────────────
# Initial passwords for seeded accounts. Everyone must change it at first sign-in.
# Must have 10+ chars with upper, lower, number and symbol.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# ── Biometric machines (eSSL / ZKTeco, read over LAN on TCP 4370 like HRMS) ──
# Pull new punches automatically every N minutes. 0 = only when Sync is clicked.
BIOMETRIC_AUTO_SYNC_MINUTES=15
# IPs or CIDR ranges machines may be added with (comma separated). Empty = private LAN only.
# Example: 192.168.1.201,192.168.1.0/24
BIOMETRIC_ALLOWED_IPS=
