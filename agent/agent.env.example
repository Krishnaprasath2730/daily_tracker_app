# Office sync agent settings. Copy to agent.env (same folder as the agent) and fill in.
# Never share or commit agent.env.

# Address of the hosted app (Hostinger temporary domain or your own domain). Must be https://
AGENT_SERVER_URL=https://your-site.hostingersite.com

# Exactly the same value as BIOMETRIC_AGENT_KEY in the hosted app's environment variables.
AGENT_KEY=

# Optional name shown in the app (defaults to this computer's name).
AGENT_NAME=Office-PC
